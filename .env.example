# App URL (used for absolute links in emails etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Postgres connection string
# Get this from Vercel Dashboard → Storage → your database → .env.local
POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Single-user password (bcrypt hash or plain string for dev)
# Used by the login form; never prefix with NEXT_PUBLIC_
AUTH_PASSWORD=changeme

# API key for the ingest endpoint (garmin-sync script and /api/ingest/*)
# Any sufficiently random string, e.g.: openssl rand -hex 32
INGEST_API_KEY=

# API key for the assistant endpoints (/api/assistant/*)
# Same format as INGEST_API_KEY
ASSISTANT_API_KEY=

# Nutrition AI provider. Keep "disabled" until cost is approved.
# Supported: disabled | stub | openai | anthropic
NUTRITION_AI_PROVIDER=disabled
# NUTRITION_AI_API_KEY=

# Training plan AI. Default disabled uses the rule engine only.
# Supported: disabled | stub | openai
# TRAINING_AI_PROVIDER=disabled
# OPENAI_API_KEY=
# TRAINING_AI_MODEL=gpt-4o-mini

# Optional Garmin Connect cloud sync (python-garminconnect token JSON or base64).
# Leave unset unless you configure cloud sync; placeholders like "changeme" are ignored.
# GARMIN_SESSION=
