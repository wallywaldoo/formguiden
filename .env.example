# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Nhost identifiers (browser-safe). Never put secrets here.
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# Server Nhost identifiers (official App Router recipe).
NHOST_SUBDOMAIN=
NHOST_REGION=eu-central-1

# Server/CLI only. Never prefix with NEXT_PUBLIC_. Leave empty in git.
NHOST_ADMIN_SECRET=

# Nutrition AI. Keep disabled until a provider and cost are approved.
# Use `stub` only for local demo (labelled Exempeldata). Never set openai/anthropic yet.
NUTRITION_AI_PROVIDER=disabled
# NUTRITION_AI_API_KEY=
